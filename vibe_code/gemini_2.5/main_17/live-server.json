{
  "port": 3000,
  "host": "0.0.0.0",
  "root": ".",
  "open": true,
  "file": "index.html",
  "mount": [
    ["/components", "./components"],
    ["/pages", "./pages"],
    ["/utils", "./utils"],
    ["/data", "./data"]
  ],
  "wait": 1000,
  "logLevel": 2,
  "middleware": [
    function(req, res, next) {
      if (req.url.endsWith('.js') && !req.url.includes('/node_modules/')) {
        res.setHeader('Content-Type', 'application/javascript');
      }
      if (req.url.endsWith('.json')) {
        res.setHeader('Content-Type', 'application/json');
      }
      next();
    }
  ]
}
